# Copy to infra/.env. Compose reads it automatically.
# Every value here has a working default in docker-compose.yml except the
# JWT keypair, which the API refuses to start without in production.

HTTP_PORT=80
MAILHOG_UI_PORT=8025

# 0 lets the API choose min(availableParallelism, 8).
CLUSTER_WORKERS=0

# Point at Atlas and set SEARCH_BACKEND=atlas to enable $search/$vectorSearch.
MONGODB_URI=mongodb://mongodb:27017/?directConnection=true
MONGODB_DB=prequit
PERSISTENCE_BACKEND=mongo
SEARCH_BACKEND=basic

API_BASE_URL=http://localhost/api/v1
APP_PUBLIC_URL=http://localhost
HTTP_CORS_ORIGINS=

# base64 of the PEM, or the PEM with \n escaped.
# openssl genrsa -out private.pem 2048
# openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
CURSOR_HMAC_SECRET=change-me-in-production

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_PROVIDER=smtp
SMTP_URL=smtp://mailhog:1025

LOG_LEVEL=info
